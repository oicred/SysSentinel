# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Required for live Gemini reasoning. Without this, SysSentinel uses mock mode.
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required when live Gemini is enabled. Share privately with judges.
DEMO_API_KEY=

# Optional live historical-ticket retrieval through the Elasticsearch REST API.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# Google Cloud deployment settings.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
