# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── Google Gemini ────────────────────────────────────────────────────────────
# Required for live Gemini inference. Without this, SysSentinel runs in MOCK mode.
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Elastic MCP Partner Integration ─────────────────────────────────────────
# Required to unlock the Elastic MCP partner track prize.
# Set up a free Elasticsearch trial at: https://cloud.elastic.co
ELASTICSEARCH_URL=https://your-cluster.es.io:443
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key_here

# ─── Google Cloud (for Cloud Run deployment) ──────────────────────────────────
# Used by: gcloud run deploy
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
