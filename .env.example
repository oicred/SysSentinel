# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Required for live Gemini reasoning. Without this, SysSentinel uses mock mode.
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional live historical-ticket retrieval through the Elasticsearch REST API.
ELASTICSEARCH_URL=https://your-cluster.es.io:443
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key_here

# Google Cloud deployment settings.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
